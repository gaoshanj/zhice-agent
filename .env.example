# ============================================================
# 培训智策 Agent — 环境变量配置模板
# 复制本文件为 .env，填入真实值，切勿提交 .env 到 Git
# ============================================================

# ── 飞书机器人配置 ──────────────────────────────────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=                      # Webhook 加密 Key（可选）
FEISHU_VERIFICATION_TOKEN=               # 事件验证 Token

# ── LLM 配置（Azure AI Foundry 资源端点 — 测试阶段）────────
# Chat 和 Embedding 共用同一资源根端点：https://<resource>.services.ai.azure.com
# 注意：不需要加 /api/projects/... 后缀
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_DEPLOYMENT=gpt-5-nano
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Embedding（同根端点，留空则复用 AZURE_OPENAI_ENDPOINT）
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_API_VERSION=2024-06-01

# ── LLM 配置（问学系统 — 生产阶段，暂时留空）───────────────
WEIXUE_API_BASE=
WEIXUE_API_KEY=
WEIXUE_MODEL=

# ── 向量数据库 ──────────────────────────────────────────────
# Azure App Service: 必须设为持久化路径（/home 不会被部署覆盖）
# 本地开发则保持 ./chroma_data
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_INTERNAL=internal_docs
CHROMA_COLLECTION_EXTERNAL=external_data

# ── 飞书 Wiki 配置（Phase 2，当前暂未使用）───────────────────
FEISHU_WIKI_SPACE_ID=                    # Wiki 空间 19 位数字 ID

# ── 飞书 Bitable 知识库（Phase 2，当前主数据源）────────────
FEISHU_BITABLE_BASE_TOKEN=CeitbAhJGaHqD1s1EricZp9intf
FEISHU_BITABLE_TABLE_ID=tblHp4aCxwHDJXKJ

# ── 飞书 OAuth 用户授权（用于以用户身份读取 Wiki）────────────
# 运行 python scripts/get_user_token.py 获取
FEISHU_USER_REFRESH_TOKEN=               # 用户级 refresh_token
# FEISHU_OAUTH_REDIRECT_URI=http://localhost:8765/oauth/callback  # 默认值

# ── 爬虫配置（Phase 3）──────────────────────────────────────
CRAWLER_REQUEST_DELAY=2.0               # 请求间隔（秒）
CRAWLER_MAX_RETRIES=3
CRAWLER_DATA_RETENTION_DAYS=180         # 保留近 6 个月
CRAWLER_TIMEOUT=20                      # 单次请求超时（秒）
CRAWLER_JOB_PAGES=3                     # 招聘数据最多爬取页数
CRAWLER_USE_PLAYWRIGHT=false            # 本地开发可设 true，Azure 部署保持 false

# Bing Search API（可选，有 key 时搜索质量更高）
# 申请地址：https://portal.azure.com → Bing Search APIs
BING_SEARCH_API_KEY=                    # 留空则用 httpx 直接搜索，稳定性稍低
BING_SEARCH_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# ── 服务配置 ────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO

# ── 管理接口密钥 ─────────────────────────────────────────────
# 用于保护 /admin/* 端点（索引重建、批量爬取等）
# Azure App Service 和 GitHub Actions Secret 中需要设置相同值
REBUILD_INDEX_SECRET=

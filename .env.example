# ============================================================
# 培训智策 Agent — 环境变量配置模板
# 复制本文件为 .env，填入真实值，切勿提交 .env 到 Git
# ============================================================

# ── 飞书机器人配置 ──────────────────────────────────────────
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_ENCRYPT_KEY=                      # Webhook 加密 Key（可选）
FEISHU_VERIFICATION_TOKEN=               # 事件验证 Token

# ── LLM 配置（Azure AI Foundry 资源端点 — 测试阶段）────────
# Chat 和 Embedding 共用同一资源根端点：https://<resource>.services.ai.azure.com
# 注意：不需要加 /api/projects/... 后缀
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AZURE_OPENAI_DEPLOYMENT=gpt-5-nano
AZURE_OPENAI_API_VERSION=2025-04-01-preview

# Embedding（同根端点，留空则复用 AZURE_OPENAI_ENDPOINT）
AZURE_EMBEDDING_ENDPOINT=
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_EMBEDDING_API_VERSION=2024-06-01

# ── LLM 配置（问学系统 — 生产阶段，暂时留空）───────────────
WEIXUE_API_BASE=
WEIXUE_API_KEY=
WEIXUE_MODEL=

# ── 向量数据库 ──────────────────────────────────────────────
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_COLLECTION_INTERNAL=internal_docs
CHROMA_COLLECTION_EXTERNAL=external_data

# ── 飞书 Wiki 配置 ───────────────────────────────────────────
# 需要同步的 Wiki Space Token（逗号分隔）
FEISHU_WIKI_SPACE_TOKENS=

# ── 爬虫配置 ────────────────────────────────────────────────
CRAWLER_REQUEST_DELAY=2.0               # 请求间隔（秒）
CRAWLER_MAX_RETRIES=3
CRAWLER_DATA_RETENTION_DAYS=180         # 保留近 6 个月

# ── 服务配置 ────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080
LOG_LEVEL=INFO
